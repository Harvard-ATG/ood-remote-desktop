Bootstrap: docker
From: ubuntu:20.04

%post
set -ex
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y \
    xfce4 \
    xfce4-goodies \
    xfce4-terminal \
    dbus-x11 \
    xdg-utils \
    x11-utils \
    curl \
    build-essential \
    libxtst6 \
    libgl1-mesa-dev \
    libglew-dev \
    libosmesa6-dev \
    libxcb-cursor0 \
    locales \
    language-pack-en-base \
    vim \
    git \
    # icon themes & mime DB & schemas
    hicolor-icon-theme \
    adwaita-icon-theme \
    shared-mime-info \
    gsettings-desktop-schemas \
    # pixbuf loaders / SVG
    libgdk-pixbuf-2.0-0 \
    libgdk-pixbuf2.0-common \
    libgdk-pixbuf2.0-bin \
    librsvg2-common \
    # gvfs, user dirs
    gvfs \
    xdg-user-dirs

# OVITO
OVITO_FILE="ovito-basic-3.13.1-x86_64"
curl -o /tmp/${OVITO_FILE}.tar.xz https://www.ovito.org/download/master/${OVITO_FILE}.tar.xz
tar -xf /tmp/${OVITO_FILE}.tar.xz --directory /tmp
mv /tmp/${OVITO_FILE} /opt
rm -f /tmp/${OVITO_FILE}.tar.xz

# OVITO XCB / GL deps
apt-get install -y \
    libxcb1 \
    libx11-xcb1 \
    libxcb-glx0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-render0 \
    libxcb-shape0 \
    libxcb-shm0 \
    libxcb-sync1 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    libxcb-xinput0 \
    libxcb-xkb1 \
    libxcb-cursor0 \
    libfontconfig1 \
    libfreetype6 \
    libopengl0 \
    libglx0 \
    libx11-6

apt-get clean
rm -rf /var/lib/apt/lists/*