Bootstrap: docker
From: ubuntu:24.04

%post
set -ex  # show commands and stop on first error

apt update -y
DEBIAN_FRONTEND=noninteractive apt install -y \
    xfce4 \
    dbus-x11 \
    xdg-utils \
    x11-utils \
    curl \
    build-essential \
    libxtst6 \
    libgl1-mesa-dev \
    libglew-dev \
    libosmesa6-dev \
    locales \
    xfce4-terminal \
    vim \
    language-pack-en-base \
    git \
    hicolor-icon-theme \
    adwaita-icon-theme \
    shared-mime-info \
    gsettings-desktop-schemas \
    dconf-gsettings-backend \
    dconf-service \
    gvfs \
    gtk-update-icon-cache

# Optional: configure locales non-interactively
# locale-gen en_US.UTF-8
# update-locale LANG=en_US.UTF-8

apt-get clean
rm -rf /var/lib/apt/lists/*